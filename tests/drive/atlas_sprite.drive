# AtlasSpriteNode: creating an AtlasSpriteNode, picking a texture, editing
# the atlas sub-region via the visual editor dialog, verifying region bounds
# and serialization, and exporting slices directly from the Sprite Sheet Slicer.
wait 5
key escape

# --- Add an AtlasSpriteNode via Add Node dialog ---
click @hier.add
expect add-node-open == true
type atlas
click @addnode.create
expect add-node-open == false
expect selected == AtlasSprite
expect node:AtlasSprite.type == AtlasSpriteNode

# Pick texture
click @insp.texture
click @pick:textures/Asteroid_2.png

# Open visual region editor dialog and drag on the canvas without moving the floating window
click @insp.atlas.edit
expect atlas.open == true
drag @atlas.canvas+-30,-30 @atlas.canvas+30,30
expect atlas.win-moved == false
expect atlas.region != 0,0,96,96
screenshot region_editor_dragged
dblclick @atlas.x
key ctrl+a
type 0
key enter
dblclick @atlas.y
key ctrl+a
type 0
key enter
dblclick @atlas.w
key ctrl+a
type 48
key enter
dblclick @atlas.h
key ctrl+a
type 48
key enter
click @atlas.apply

# Undo/redo and save scene: verify no bogus child Sprite TextureNode is created
key ctrl+z
key ctrl+y
expect node:AtlasSprite.children == 0
screenshot only_the_region

# #375: a region at the right edge with Width 0 stays inside, 1 px wide;
# the node deleted while the editor is open: Apply does nothing (says so).
click @hier:AtlasSprite
click @insp.atlas.edit
expect atlas.region == 0,0,48,48
dblclick @atlas.x
key ctrl+a
type 494
key enter
dblclick @atlas.w
key ctrl+a
type 0
key enter
wait 1
expect atlas.region == 493,0,1,48
click @hier:AtlasSprite
key delete
wait 2
expect node:AtlasSprite.exists == false
expect item:atlas.gone == visible
screenshot region_editor_node_gone
click @atlas.apply
wait 1
expect log contains nothing applied
expect atlas.open == false
key ctrl+z
wait 2
expect node:AtlasSprite.exists == true
key ctrl+s
expect file:scenes/main.scene.json contains "AtlasSpriteNode"
expect file:scenes/main.scene.json contains "region": [

# --- Test Sprite Slicer export to AtlasSpriteNode ---
click @menu:Tools
click @menu:Tools/Sprite Sheet Slicer...
click @slicer.texture
click @pick:textures/Asteroid_2.png
click @slicer.cell:0
click @slicer.create-atlas
expect selected == Asteroid_2
expect node:Asteroid_2.type == AtlasSpriteNode
key ctrl+s
